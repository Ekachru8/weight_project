// HomeFit Database Schema — PostgreSQL via Prisma
datasource db {
  provider = "postgresql"
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

// ── NextAuth Models ──

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── App Models ──

model User {
  id              Int          @id @default(autoincrement())
  name            String       @default("HomeFit User")
  email           String?      @unique
  emailVerified   DateTime?
  image           String?
  passwordHash    String?
  phoneNumber     String?      @unique
  age             Int?
  gender          String?      // "male" | "female"
  heightCm        Float?
  weightKg        Float?
  targetWeightKg  Float?
  activityLevel   String?      // sedentary | light | moderate | very_active | extra_active
  goal            String?      // "lose" | "gain" | "maintain"
  dietPreference  String?      // "veg" | "non_veg" | "both"
  equipment       String       @default("Dumbbells, Resistance Band, Yoga Mat")
  onboardingDone  Boolean      @default(false)
  fitnessReadiness Json?
  
  // Nutrition Preferences
  foodsTheyEat       String?
  comfortableFoods   String?
  foodsToAvoid       String?
  allergies          String?
  budget             String?
  openToNewFoods     Boolean?
  mealsPerDay        Int?
  cookingConstraints String?

  // Fitness Readiness
  fitnessLevel        String?
  mobilityLevel       String?
  difficultMovements  String?
  intensityPreference String?
  healthNotes         String?
  workoutFocus        String?

  createdAt       DateTime     @default(now())
  accounts        Account[]
  sessions        Session[]
  workoutLogs     WorkoutLog[]
  weightLogs      WeightLog[]
  dietTargets     DietTarget[]
}

model Exercise {
  id                         Int      @id @default(autoincrement())
  slug                       String   @unique
  name                       String
  category                   String
  difficulty                 String   @default("Beginner")
  equipment                  String
  targetMuscles              String[]
  movementPattern            String   @default("Compound")
  description                String   @default("")
  formCues                   String[]
  instructions               String[]
  commonMistakes             String[]
  safetyTips                 String[]
  defaultSets                Int      @default(3)
  defaultReps                String   @default("10-12")
  estimatedCaloriesPerMinute Int      @default(5)
  videoUrl                   String?
  videoStatus                String   @default("not_started")
  videoExerciseSlug          String?
  audioUrl                   String?
  audioStatus                String   @default("not_started")
  transcript                 String?

  // Legacy program fields
  dayNumber                  Int?
  dayName                    String?
  sortOrder                  Int?
  muscleGroup                String?
  sets                       Int?
  reps                       String?
}

model WorkoutLog {
  id        Int     @id @default(autoincrement())
  userId    Int
  date      String  // "YYYY-MM-DD" for easy querying
  dayNumber Int
  completed Boolean
  notes     String?
  user      User    @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model WeightLog {
  id       Int    @id @default(autoincrement())
  userId   Int
  date     String // "YYYY-MM-DD"
  weightKg Float
  user     User   @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model DietTarget {
  id          Int      @id @default(autoincrement())
  userId      Int
  calories    Int
  proteinG    Float
  carbsG      Float
  fatG        Float
  generatedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model VideoJob {
  id            Int      @id @default(autoincrement())
  exerciseSlug  String
  status        String   // "queued" | "generating" | "processing" | "ready" | "failed"
  provider      String
  providerJobId String?
  videoUrl      String?
  thumbnailUrl  String?
  audioUrl      String?
  audioStatus   String?
  transcript    String?
  prompt        String
  promptVersion String
  errorMessage  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
