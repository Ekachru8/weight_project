// HomeFit Database Schema — PostgreSQL via Prisma
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ── NextAuth Models ──

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── App Models ──

model User {
  id              Int          @id @default(autoincrement())
  name            String       @default("HomeFit User")
  email           String?      @unique
  emailVerified   DateTime?
  image           String?
  passwordHash    String?
  phoneNumber     String?      @unique
  age             Int?
  gender          String?      // "male" | "female"
  heightCm        Float?
  weightKg        Float?
  targetWeightKg  Float?
  activityLevel   String?      // sedentary | light | moderate | very_active | extra_active
  goal            String?      // "lose" | "gain" | "maintain"
  dietPreference  String?      // "veg" | "non_veg" | "both"
  equipment       String       @default("Dumbbells, Resistance Band, Yoga Mat")
  onboardingDone  Boolean      @default(false)
  createdAt       DateTime     @default(now())
  accounts        Account[]
  sessions        Session[]
  workoutLogs     WorkoutLog[]
  weightLogs      WeightLog[]
  dietTargets     DietTarget[]
}

model Exercise {
  id            Int     @id @default(autoincrement())
  dayNumber     Int     // 1–6 (no exercises for day 7 rest)
  dayName       String  // "Chest", "Back", "Legs", "Shoulders", "Arms", "Core"
  name          String
  muscleGroup   String
  equipment     String
  sets          Int
  reps          String  // String to support "30–45 sec", "12/side", "15 steps/side"
  formCue       String
  sortOrder     Int
  hoverVideoUrl String?
  fullVideoUrl  String?
}

model WorkoutLog {
  id        Int     @id @default(autoincrement())
  userId    Int
  date      String  // "YYYY-MM-DD" for easy querying
  dayNumber Int
  completed Boolean
  notes     String?
  user      User    @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model WeightLog {
  id       Int    @id @default(autoincrement())
  userId   Int
  date     String // "YYYY-MM-DD"
  weightKg Float
  user     User   @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model DietTarget {
  id          Int      @id @default(autoincrement())
  userId      Int
  calories    Int
  proteinG    Float
  carbsG      Float
  fatG        Float
  generatedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}
